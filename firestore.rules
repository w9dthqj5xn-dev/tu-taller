rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsWorkshop(username) {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios-data/$(username))
        && get(/databases/$(database)/documents/usuarios-data/$(username)).data.authUid == request.auth.uid
        && request.auth.token.username == username;
    }

    match /usuarios/{userId} {
      allow get, list: if signedIn() && resource.data.authUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /usuarios-data/{username} {
      allow get: if ownsWorkshop(username);
      allow list, delete: if false;
      allow create: if signedIn()
        && request.auth.token.username == username
        && request.resource.data.authUid == request.auth.uid;
      allow update: if ownsWorkshop(username)
        && request.resource.data.authUid == request.auth.uid;

      match /{collection}/{document=**} {
        allow read, write: if ownsWorkshop(username);
      }
    }

    match /configuraciones/{username} {
      allow read, write: if ownsWorkshop(username);
    }

    match /licencias/{licenseId} {
      allow read, write: if signedIn() && request.auth.token.admin == true;
    }

    match /usuarios-google/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
